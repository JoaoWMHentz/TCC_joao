<?xml version="1.0" encoding="utf-8"?>
<!--
  robot.urdf.xacro — Plataforma robótica móvel diferencial (TCC)

  Robô diferencial de duas rodas coaxiais com corpo cilíndrico.
  Sensores: LiDAR 2D, câmera RGB-D e IMU. O visual usa as malhas da carcaça
  (meshes/*.STL); a colisão usa primitivas, mais leves para a física.

  Convenções (REP-103/105):
    base_link  : no chão, sob o centro do eixo das rodas (X frente, Y esquerda)
    chassis_link : centro geométrico do corpo (deslocado de chassis_offset_x)
-->
<robot name="tcc_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ── Rodas ─────────────────────────────────────────────────────── -->
  <xacro:property name="wheel_radius"     value="0.0825" />
  <xacro:property name="wheel_separation" value="0.310" />
  <xacro:property name="wheel_width"      value="0.050" />
  <xacro:property name="wheel_mass"       value="0.958" />

  <!-- ── Corpo ─────────────────────────────────────────────────────── -->
  <!-- O centro do corpo fica atrás do eixo das rodas. -->
  <xacro:property name="chassis_offset_x" value="-0.075" />
  <xacro:property name="chassis_z"        value="0.0305" />
  <xacro:property name="body_radius"      value="0.245" />
  <xacro:property name="body_height"      value="0.120" />
  <xacro:property name="body_mass"        value="11.7" />

  <!-- ── Sensores (relativos ao chassis_link) ──────────────────────── -->
  <xacro:property name="lidar_x" value="0.0" />
  <xacro:property name="lidar_y" value="0.0" />
  <xacro:property name="lidar_z" value="0.095" />

  <xacro:property name="imu_x" value="-0.05" />
  <xacro:property name="imu_y" value="-0.10" />
  <xacro:property name="imu_z" value="0.05" />

  <!-- Câmera montada invertida (roll = pi) e inclinada 35° para baixo -->
  <xacro:property name="camera_x"     value="0.200" />
  <xacro:property name="camera_y"     value="0.0" />
  <xacro:property name="camera_z"     value="0.150" />
  <xacro:property name="camera_roll"  value="${pi}" />
  <xacro:property name="camera_pitch" value="${-35.0 * pi / 180}" />
  <xacro:property name="camera_yaw"   value="0.0" />

  <!-- ── Macros de inércia ─────────────────────────────────────────── -->
  <xacro:macro name="inertia_zero">
    <inertia ixx="1e-09" ixy="0" ixz="0" iyy="1e-09" iyz="0" izz="1e-09" />
  </xacro:macro>
  <xacro:macro name="inertia_cylinder" params="m r h">
    <inertia ixx="${m*(3*r*r + h*h)/12.0}" ixy="0" ixz="0"
             iyy="${m*(3*r*r + h*h)/12.0}" iyz="0"
             izz="${m*r*r/2.0}" />
  </xacro:macro>

  <material name="body_gray">  <color rgba="0.25 0.25 0.28 1" /></material>
  <material name="wheel_black"><color rgba="0.08 0.08 0.08 1" /></material>
  <material name="sensor_dark"><color rgba="0.10 0.10 0.10 1" /></material>

  <!-- ================================================================ -->
  <link name="base_link" />

  <joint name="base_to_chassis" type="fixed">
    <origin xyz="${chassis_offset_x} 0 ${chassis_z}" rpy="0 0 0" />
    <parent link="base_link" />
    <child  link="chassis_link" />
  </joint>

  <link name="chassis_link">
    <inertial>
      <origin xyz="0 0 0.07" />
      <mass value="${body_mass}" />
      <xacro:inertia_cylinder m="${body_mass}" r="${body_radius}" h="${body_height}" />
    </inertial>
    <visual>
      <!-- Malha exportada do CAD com Y para cima: corrigida aqui -->
      <origin rpy="${pi/2} 0 ${pi/2}" />
      <geometry>
        <mesh filename="package://description/meshes/chassis_link.STL" />
      </geometry>
      <material name="body_gray" />
    </visual>
    <collision>
      <origin xyz="0 0 0.07" />
      <geometry><cylinder radius="${body_radius}" length="${body_height}" /></geometry>
    </collision>
  </link>

  <!-- ── Rodas ─────────────────────────────────────────────────────── -->
  <xacro:macro name="wheel" params="side y visual_roll">
    <link name="${side}_wheel_link">
      <inertial>
        <mass value="${wheel_mass}" />
        <xacro:inertia_cylinder m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}" />
      </inertial>
      <visual>
        <origin rpy="${visual_roll} 0 0" />
        <geometry>
          <mesh filename="package://description/meshes/${side}_wheel_link.STL" />
        </geometry>
        <material name="wheel_black" />
      </visual>
      <collision>
        <origin rpy="${pi/2} 0 0" />
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}" /></geometry>
      </collision>
    </link>
    <joint name="${side}_wheel_joint" type="continuous">
      <origin xyz="${-chassis_offset_x} ${y} ${wheel_radius - chassis_z}" />
      <parent link="chassis_link" />
      <child  link="${side}_wheel_link" />
      <axis xyz="0 1 0" />
      <dynamics damping="0.1" friction="0.1" />
    </joint>
  </xacro:macro>

  <xacro:wheel side="left"  y="${wheel_separation/2}"  visual_roll="${3*pi/2}" />
  <xacro:wheel side="right" y="${-wheel_separation/2}" visual_roll="${pi/2}" />

  <!-- ── IMU ───────────────────────────────────────────────────────── -->
  <joint name="imu_joint" type="fixed">
    <origin xyz="${imu_x} ${imu_y} ${imu_z}" />
    <parent link="chassis_link" />
    <child  link="imu_link" />
  </joint>
  <link name="imu_link" />

  <!-- ── LiDAR 2D ──────────────────────────────────────────────────── -->
  <joint name="lidar_joint" type="fixed">
    <origin xyz="${lidar_x} ${lidar_y} ${lidar_z}" />
    <parent link="chassis_link" />
    <child  link="lidar_link" />
  </joint>
  <link name="lidar_link">
    <visual>
      <geometry>
        <mesh filename="package://description/meshes/lidar_link.STL" />
      </geometry>
      <material name="sensor_dark" />
    </visual>
  </link>

  <!-- Frame publicado pelo driver sllidar_ros2 (montagem girada 180°) -->
  <joint name="lidar_scan_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 ${pi}" />
    <parent link="lidar_link" />
    <child  link="lidar_scan_link" />
  </joint>
  <link name="lidar_scan_link" />

  <!-- ── Câmera RGB-D (Orbbec Astra) ───────────────────────────────── -->
  <joint name="camera_joint" type="fixed">
    <origin xyz="${camera_x} ${camera_y} ${camera_z}"
            rpy="${camera_roll} ${camera_pitch} ${camera_yaw}" />
    <parent link="chassis_link" />
    <child  link="camera_link" />
  </joint>
  <link name="camera_link">
    <visual>
      <geometry><box size="0.040 0.165 0.030" /></geometry>
      <material name="sensor_dark" />
    </visual>
  </link>

  <xacro:macro name="optical_frame" params="name">
    <joint name="camera_${name}_joint" type="fixed">
      <parent link="camera_link" />
      <child  link="camera_${name}_frame" />
    </joint>
    <link name="camera_${name}_frame" />
    <joint name="camera_${name}_optical_joint" type="fixed">
      <origin rpy="${-pi/2} 0 ${-pi/2}" />
      <parent link="camera_${name}_frame" />
      <child  link="camera_${name}_optical_frame" />
    </joint>
    <link name="camera_${name}_optical_frame" />
  </xacro:macro>

  <xacro:optical_frame name="color" />
  <xacro:optical_frame name="depth" />

</robot>
