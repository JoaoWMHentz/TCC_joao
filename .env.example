# Copie para .env e ajuste. Lido pelos scripts e pelo backend web.

# Pasta onde os mapas (.db do RTAB-Map) são salvos
# MAPS_DIR=~/tcc_maps

# Banco de dados da interface web (docker compose em web/)
# DATABASE_URL=postgresql://tcc:tcc@localhost:5433/tcc

# Usar a câmera RGB-D no RTAB-Map (false = só LiDAR)
# USE_CAMERA=true

# Porta da interface web
# WEB_PORT=5000

# Workspace ROS 2 (padrão: dois níveis acima deste repositório)
# WS_DIR=~/ros2_ws
