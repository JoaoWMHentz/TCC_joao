<?xml version="1.0" ?>
<!--
  pessoa.sdf — obstáculo dinâmico: um "cliente" que caminha em vai-e-vem
  pelo corredor da loja (plugin TrajectoryFollower). Usado nos testes de
  replanejamento e desvio. A inércia alta em X/Y impede que o cilindro tombe.
-->
<sdf version="1.10">
  <model name="pessoa">
    <link name="corpo">
      <pose>0 0 0.85 0 0 0</pose>
      <inertial>
        <mass>60</mass>
        <inertia>
          <ixx>1000</ixx><iyy>1000</iyy><izz>1.5</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="c">
        <geometry><cylinder><radius>0.22</radius><length>1.7</length></cylinder></geometry>
        <surface><friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction></surface>
      </collision>
      <visual name="v">
        <geometry><cylinder><radius>0.22</radius><length>1.7</length></cylinder></geometry>
        <material><ambient>0.1 0.3 0.7 1</ambient><diffuse>0.1 0.3 0.7 1</diffuse></material>
      </visual>
    </link>
    <plugin filename="gz-sim-trajectory-follower-system"
            name="gz::sim::systems::TrajectoryFollower">
      <link_name>corpo</link_name>
      <loop>true</loop>
      <force>150</force>
      <torque>20</torque>
      <range_tolerance>0.2</range_tolerance>
      <bearing_tolerance>0.3</bearing_tolerance>
      <waypoint>-3.0 -1.8</waypoint>
      <waypoint>1.8 -1.8</waypoint>
    </plugin>
  </model>
</sdf>
