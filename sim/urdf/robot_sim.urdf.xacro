<?xml version="1.0" encoding="utf-8"?>
<!--
  robot_sim.urdf.xacro — o mesmo robô do description, mais o que o Gazebo
  Harmonic precisa para simulá-lo. O modelo real não é alterado.

  hardware real                      ->  simulação
  hardware_node (motores, odom, IMU) ->  DiffDrive + sensor IMU do gz
  RPLidar                            ->  gpu_lidar   (/scan_raw)
  Orbbec Astra                       ->  rgbd_camera (/camera/...)

  Tópicos gz são ligados ao ROS por config/ros_gz_bridge.yaml com os mesmos
  nomes do robô real, então RTAB-Map, Nav2 e a interface web não mudam.
-->
<robot name="tcc_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find description)/urdf/robot.urdf.xacro" />

  <xacro:property name="caster_radius" value="0.02" />

  <!-- ── Rodízios de apoio ───────────────────────────────────────────── -->
  <!-- O robô real se equilibra em duas rodas coaxiais; no simulador o
       corpo tombaria. Duas esferas de baixo atrito dão os pontos de apoio. -->
  <xacro:macro name="caster" params="name x">
    <joint name="caster_${name}_joint" type="fixed">
      <origin xyz="${x} 0 ${-chassis_z + caster_radius}" />
      <parent link="chassis_link" />
      <child  link="caster_${name}_link" />
    </joint>
    <link name="caster_${name}_link">
      <inertial>
        <mass value="0.01" />
        <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
      </inertial>
      <collision>
        <geometry><sphere radius="${caster_radius}" /></geometry>
      </collision>
    </link>
    <gazebo reference="caster_${name}_link">
      <mu1>0.01</mu1>
      <mu2>0.01</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:caster name="front" x="0.20" />
  <xacro:caster name="rear"  x="-0.20" />

  <gazebo reference="left_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>
  <gazebo reference="right_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
  </gazebo>

  <!-- ── Acionamento diferencial e estado das juntas ─────────────────── -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <topic>/sim/cmd_vel</topic>
      <odom_topic>/model/tcc_robot/odometry</odom_topic>
      <tf_topic>/model/tcc_robot/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>25</odom_publish_frequency>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
      <min_angular_acceleration>-2.0</min_angular_acceleration>
    </plugin>
    <!-- Verdade de campo (pose exata no mundo) para as métricas de localização -->
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>/model/tcc_robot/ground_truth</odom_topic>
      <odom_publish_frequency>20</odom_publish_frequency>
      <dimensions>2</dimensions>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/model/tcc_robot/joint_states</topic>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

  <!-- ── LiDAR 2D ────────────────────────────────────────────────────── -->
  <!-- Alcance mínimo fora do corpo (raio 0.245 m) para o próprio robô não
       aparecer na leitura — no real o laser_filters faz o mesmo. -->
  <gazebo reference="lidar_scan_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>/scan_raw</topic>
      <gz_frame_id>lidar_scan_link</gz_frame_id>
      <update_rate>10</update_rate>
      <always_on>1</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>720</samples>
            <min_angle>-3.141592</min_angle>
            <max_angle>3.141592</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.26</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ── IMU ─────────────────────────────────────────────────────────── -->
  <gazebo reference="imu_link">
    <sensor name="imu" type="imu">
      <topic>/imu/data</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <update_rate>100</update_rate>
      <always_on>1</always_on>
    </sensor>
  </gazebo>

  <!-- ── Câmera RGB-D ────────────────────────────────────────────────── -->
  <!-- Imagens saem no frame ótico (Z para a frente), como no driver real.
       Profundidade limitada a 2.5 m, alcance útil da Astra. -->
  <gazebo reference="camera_link">
    <sensor name="rgbd_camera" type="rgbd_camera">
      <topic>/camera</topic>
      <gz_frame_id>camera_color_optical_frame</gz_frame_id>
      <update_rate>15</update_rate>
      <always_on>1</always_on>
      <camera>
        <horizontal_fov>1.0472</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>15.0</far>
        </clip>
        <depth_camera>
          <clip>
            <near>0.3</near>
            <far>2.5</far>
          </clip>
        </depth_camera>
      </camera>
    </sensor>
  </gazebo>

</robot>
