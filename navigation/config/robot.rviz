Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane Cell Count: 20
      Color: 160; 160; 164
    - Class: rviz_default_plugins/Map
      Name: Mapa (RTAB-Map)
      Enabled: true
      Topic:
        Value: /map
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Color Scheme: map
      Alpha: 1
    - Class: rviz_default_plugins/Map
      Name: Costmap global
      Enabled: true
      Topic:
        Value: /global_costmap/costmap
        Reliability Policy: Reliable
      Color Scheme: costmap
      Alpha: 0.3
    - Class: rviz_default_plugins/Map
      Name: Costmap local
      Enabled: true
      Topic:
        Value: /local_costmap/costmap
        Reliability Policy: Reliable
      Color Scheme: costmap
      Alpha: 0.5
    - Class: rviz_default_plugins/RobotModel
      Name: Robô
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
    - Class: rviz_default_plugins/LaserScan
      Name: LiDAR
      Enabled: true
      Topic:
        Value: /scan
        Reliability Policy: Best Effort
      Color Transformer: FlatColor
      Color: 255; 0; 0
      Size (m): 0.04
    - Class: rviz_default_plugins/PointCloud2
      Name: Nuvem da câmera
      Enabled: true
      Topic:
        Value: /camera/depth/points
        Reliability Policy: Best Effort
      Style: Points
      Size (Pixels): 3
      Color Transformer: AxisColor
      Axis: Z
    - Class: rtabmap_rviz_plugins/MapCloud
      Name: Mapa 3D (RTAB-Map)
      Enabled: true
      Topic:
        Value: /mapData
        Reliability Policy: Reliable
      Style: Points
      Size (Pixels): 2
      Cloud decimation: 4
      Cloud max depth (m): 4
    - Class: rviz_default_plugins/Path
      Name: Caminho planejado
      Enabled: true
      Topic:
        Value: /plan
      Color: 25; 100; 255
      Line Width: 0.05
      Line Style: Billboards
    - Class: rviz_default_plugins/Image
      Name: Câmera
      Enabled: false
      Topic:
        Value: /camera/color/image_raw
        Reliability Policy: Best Effort
  Enabled: true
  Global Options:
    Fixed Frame: map
    Background Color: 48; 48; 48
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
    - Class: rviz_default_plugins/Measure
  Views:
    # 3D, seguindo o robô: arraste com o botão esquerdo para girar, rodinha
    # para zoom, Shift+arrastar para mover. A vista de cima (2D) fica salva
    # no painel "Views" (duplo clique em "Vista de cima").
    Current:
      Class: rviz_default_plugins/Orbit
      Name: 3D (segue o robô)
      Target Frame: base_link
      Distance: 8
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Pitch: 0.7
      Yaw: 3.5
    Saved:
      - Class: rviz_default_plugins/TopDownOrtho
        Name: Vista de cima
        Scale: 30
        X: 0
        Y: 0
      - Class: rviz_default_plugins/Orbit
        Name: 3D (mapa todo)
        Target Frame: map
        Distance: 30
        Focal Point:
          X: 0
          Y: 0
          Z: 0
        Pitch: 0.9
        Yaw: 4.2
Window Geometry:
  Width: 1400
  Height: 900
