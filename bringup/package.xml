<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bringup</name>
  <version>0.1.0</version>
  <description>Inicialização do robô físico: URDF, driver de hardware, LiDAR e câmera RGB-D</description>
  <maintainer email="joao.hentz@catolicasc.edu.br">João Witor Müller Hentz</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>description</exec_depend>
  <exec_depend>hardware</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>laser_filters</exec_depend>
  <exec_depend>sllidar_ros2</exec_depend>
  <exec_depend>astra_camera</exec_depend>
  <exec_depend>foxglove_bridge</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
